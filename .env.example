# Copy to .env on the Mac mini. Never commit real passwords or broker credentials.
STOCK_DATABASE_URL=postgresql://stock_runtime:REPLACE_ME@127.0.0.1:56322/postgres
# Used only for migrations/provisioning, not the application worker.
STOCK_ADMIN_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56322/postgres
STOCK_BROKER=innovestx
STOCK_MODE=research
STOCK_TIMEZONE=Asia/Bangkok
# The live adapter is deliberately absent; changing this does not enable orders.
STOCK_LIVE_ENABLED=false
